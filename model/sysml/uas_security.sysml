    satisfy 'SR-005' by UAS_Architecture::uasSystem.airVehicle.missionComputing.cc;
    requirement 'SR-006' : SecurityRequirement {
        doc /* The CC shall mount its root filesystem read-only with block-level integrity verification. */
        comment rationale /* Extends the verified boot chain to the root filesystem, so offline or runtime modification is detected when blocks are read. */
