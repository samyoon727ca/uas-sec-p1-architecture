    }
    dependency from 'THR-054' to UAS_Architecture::'DF-07';
    concern 'THR-055' : Threat {
        doc /* False navigation data injected on the NAV-FC wiring. Someone with physical access to the airframe taps the navigation module's wiring and injects false position or heading. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-055' to UAS_Architecture::'DF-08';
    concern 'THR-056' : Threat {
        doc /* Actuator commands altered on the FC-ESC wiring. Someone with physical access to the airframe taps the actuator wiring and alters motor commands. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-056' to UAS_Architecture::'DF-09';
    concern 'THR-057' : Threat {
        doc /* Unauthorized peer installs the first signing key. Before a key exists, PX4 v1.18 accepts SETUP_SIGNING unsigned on any link. A peer that reaches any FC link first installs its own key and locks out the GCS until the SD card is cleared. Source: the v1.18 change that accepts SETUP_SIGNING on any link instead of USB only. */
        attribute :>> missionImpact = MissionImpact::'MI-2';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-057' to UAS_Architecture::'DF-11';
    concern 'THR-058' : Threat {
        doc /* Unsigned firmware loaded through the USB bootloader. The PX4 bootloader accepts any firmware image over USB unless secure boot is enabled. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-058' to UAS_Architecture::'DF-11';
    concern 'THR-059' : Threat {
        doc /* Malicious image or credentials loaded into the CC. A rogue maintenance device, or a compromised MSS, loads a modified image or replacement credentials over the maintenance link. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-059' to UAS_Architecture::'DF-12';
    concern 'THR-060' : Threat {
        doc /* Keys exposed on removable media during GCS provisioning. Signing and WireGuard keys copied to removable media for the GCS can be lost, copied or left behind. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'informationDisclosure';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-060' to UAS_Architecture::'DF-13';
    concern 'THR-061' : Threat {
        doc /* Crafted offload data exploits the MSS. A compromised CC returns crafted imagery or logs that exploit software on the MSS, the host with every key. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-061' to UAS_Architecture::'DF-14';
    concern 'THR-062' : Threat {
        doc /* Crafted flight logs exploit MSS log tools. A tampered FC or SD card returns crafted ULogs that exploit log-analysis tools on the MSS. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-062' to UAS_Architecture::'DF-15';
    concern 'THR-063' : Threat {
        doc /* Compromised upstream release enters the build. A malicious change in a legitimate upstream project or release (a PX4 submodule, a distribution package or a toolchain) is built into signed artifacts. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-063' to UAS_Architecture::'DF-16';
    concern 'THR-064' : Threat {
        doc /* Flaw in PX4's signing implementation lets forged frames through. PX4 states its signing implementation has not been audited, and signing fixes are still landing: PR #28891 (forwarding of signed frames) merged on main on 2026-09-30, after the pinned v1.18.0-rc1. A remaining flaw could let a peer without the key pass signature checks. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'spoofing';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-064' to UAS_Architecture::'CMP-FC';
    concern 'THR-065' : Threat {
        doc /* Signed frames replayed after an FC reboot. PX4 notes the on-disk signing timestamp usually stays at its provisioning value, because vehicles are powered off without a graceful shutdown. Assumption, to be checked in VE-02: after a reboot, frames recorded since provisioning may pass the timestamp check. Over RF the adversary sees only WireGuard ciphertext, so recording needs a tap inside the vehicle or a key holder. */
        attribute :>> missionImpact = MissionImpact::'MI-1';
        attribute :>> stride = StrideCategory::'tampering';
        attribute :>> disposition = Disposition::'mitigate';
    }
    dependency from 'THR-065' to UAS_Architecture::'DF-04';

    // 44 requirements (docs/07-requirements.md)
    requirement 'SR-001' : SecurityRequirement {
        doc /* The CC shall discard all traffic on its radio interface except WireGuard traffic from the provisioned GCS peer. */
        comment rationale /* Keeps RF-injected MAVLink, including the four messages PX4 accepts unsigned, from reaching the MAVLink router or the FC (THR-001). Verified by VE-01. */
        frame 'THR-001';
        frame 'THR-006';
        frame 'THR-010';
        frame 'THR-014';
        frame 'THR-042';
        frame 'THR-043';
        frame 'THR-046';
        frame 'THR-048';
        frame 'THR-064';
        frame 'THR-065';
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Segmentation: Predefined Segmentation", "Deception: Obfuscation", "Coordinated Protection: Calibrated Defense-in-Depth");
    }
    satisfy 'SR-001' by UAS_Architecture::uasSystem.airVehicle.missionComputing.cc;
    requirement 'SR-002' : SecurityRequirement {
