        attribute :>> resiliencyApproach = ("Substantiated Integrity: Provenance Tracking");
    }
    satisfy 'SR-033' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-034' : SecurityRequirement {
        doc /* The MSS shall hold software signing private keys in a hardware security module that does not export them. */
        comment rationale /* Even a compromised MSS cannot copy the signing keys. */
        frame 'THR-020';
        frame 'THR-023';
        frame 'THR-039';
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Privilege Restriction: Attribute-Based Usage Restriction");
    }
    satisfy 'SR-034' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-035' : SecurityRequirement {
        doc /* The MSS shall keep an encrypted offline backup of each software signing key. */
        comment rationale /* Losing a signing key would leave devices unable to accept updates. */
        frame 'THR-040';
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Redundancy: Protected Backup and Restore");
    }
    satisfy 'SR-035' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-036' : SecurityRequirement {
        doc /* The MSS shall provision a new MAVLink signing key to the FC, CC and GCS after any loss of physical custody of a key holder. */
        comment rationale /* The key is shared and PX4 has no automatic rotation, so one exposed holder exposes all of them. */
        frame 'THR-007';
        frame 'THR-016';
        frame 'THR-026';
        frame 'THR-034';
        frame 'THR-037';
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Non-Persistence: Non-Persistent Information");
    }
    satisfy 'SR-036' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-037' : SecurityRequirement {
        doc /* The MSS shall provision the first signing key on the FC over USB at first power-up, before any other link is connected. */
        comment rationale /* Closes the provisioning window created by PX4 v1.18 accepting the first key on any link. */
        frame 'THR-057';
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Privilege Restriction: Trust-Based Privilege Management");
    }
    satisfy 'SR-037' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-038' : SecurityRequirement {
        doc /* The MSS shall process offloaded vehicle data in an account that has no access to key material. */
        comment rationale /* Data returned from the vehicle is untrusted input to the host that holds every key. */
        frame 'THR-061';
        frame 'THR-062';
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P4";
        attribute :>> resiliencyApproach = ("Segmentation: Predefined Segmentation");
    }
    satisfy 'SR-038' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-039' : SecurityRequirement {
        doc /* The MSS shall log each software load and key-provisioning action with the maintainer's identity. */
        comment rationale /* Makes maintenance actions attributable. */
        frame 'THR-022';
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
        attribute :>> resiliencyApproach = ("Analytic Monitoring: Forensic and Behavioral Analysis");
    }
    satisfy 'SR-039' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-040' : SecurityRequirement {
        doc /* The MSS shall require individual maintainer authentication. */
        comment rationale /* Prevents use of an unattended MSS and supports SR-039. */
        frame 'THR-020';
        frame 'THR-022';
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
        attribute :>> resiliencyApproach = ("Privilege Restriction: Trust-Based Privilege Management");
    }
    satisfy 'SR-040' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-041' : SecurityRequirement {
        doc /* The MSS shall record the firmware versions of the GNSS module, ESCs, radios and payload at each maintenance action and compare them with the approved baseline. */
        comment rationale /* Detects peripheral firmware changed through maintenance or replacement parts. */
        frame 'THR-011';
        frame 'THR-012';
        frame 'THR-013';
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
        attribute :>> resiliencyApproach = ("Substantiated Integrity: Integrity Checks");
    }
    satisfy 'SR-041' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-042' : SecurityRequirement {
        doc /* The MSS shall provision GCS keys over a direct wired connection and never through removable media. */
        comment rationale /* Removes the copy of the keys that removable media would leave behind. */
        frame 'THR-060';
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
        attribute :>> resiliencyApproach = ("Non-Persistence: Non-Persistent Information");
    }
    satisfy 'SR-042' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-043' : SecurityRequirement {
        doc /* The MSS shall generate and provision keys only while disconnected from external networks. */
        comment rationale /* Separates key handling from the online upstream intake (DF-16). */
        frame 'THR-023';
        frame 'THR-039';
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
        attribute :>> resiliencyApproach = ("Non-Persistence: Non-Persistent Connectivity");
    }
    satisfy 'SR-043' by UAS_Architecture::uasSystem.mss;
    requirement 'SR-044' : SecurityRequirement {
        doc /* The CC shall accept maintenance connections only when authenticated with the MSS maintenance key. */
        comment rationale /* Stops a rogue device on the maintenance port from loading images or credentials. */
        frame 'THR-059';
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P4";
        attribute :>> resiliencyApproach = ("Privilege Restriction: Trust-Based Privilege Management");
    }
    satisfy 'SR-044' by UAS_Architecture::uasSystem.airVehicle.missionComputing.cc;

    // 16 verification events (docs/08-verification-plan.md)
    verification 'VE-01' : SecurityVerification {
        doc /* Spoofed GCS heartbeats do not suppress the data-link-loss failsafe. Pass: FC enters Return within COM_DL_LOSS_T plus a stated tolerance; CC and GCS counters show injected packets dropped; control run shows the failsafe suppressed. */
        objective {
            verify 'SR-001';
            verify 'SR-002';
            verify 'SR-004';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-02' : SecurityVerification {
        doc /* Signed C2 works with the pinned versions. Pass: Signed commands execute; unsigned and wrongly signed commands have no effect; the GCS alerts on unsigned telemetry. Closes OI-01. */
        objective {
            verify 'SR-003';
            verify 'SR-025';
        }
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-03' : SecurityVerification {
        doc /* CC accepts only signed, newer update images. Pass: Only the valid newer image installs; each rejection is logged. */
        objective {
            verify 'SR-007';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-04' : SecurityVerification {
        doc /* CC autonomy ignores unsigned or altered FC telemetry. Pass: Autonomy decisions use only frames with valid signatures; injected frames are logged and discarded. */
        objective {
            verify 'SR-015';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-05' : SecurityVerification {
        doc /* Imagery and flight logs are unreadable without the MSS key. Pass: Copies from the vehicle are unreadable; the MSS decrypts both. */
        objective {
            verify 'SR-017';
            verify 'SR-019';
        }
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-06' : SecurityVerification {
        doc /* Key management on the MSS. Pass: Export fails; the restored key signs an artifact that verifies; after rotation the old key is rejected by FC, CC and GCS; first-key provisioning follows the defined order. */
        objective {
            verify 'SR-034';
            verify 'SR-035';
            verify 'SR-036';
            verify 'SR-037';
        }
        attribute :>> method = VerificationMethod::'demonstration';
        attribute :>> evidenceRepo = "P3";
    }
    verification 'VE-07' : SecurityVerification {
        doc /* CC verified boot and key sealing. Pass: Only the signed chain boots; the keys unseal only in the measured, unmodified boot state. */
        objective {
            verify 'SR-005';
            verify 'SR-010';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P2";
    }
    verification 'VE-08' : SecurityVerification {
        doc /* FC boots only signed firmware. Pass: Only the signed image starts PX4; the others stay in the bootloader. */
        objective {
            verify 'SR-018';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P2";
    }
    verification 'VE-09' : SecurityVerification {
        doc /* CC image hardening. Pass: Modified blocks fail to read; only the signing service reads the key; confined services cannot reach credentials; the device is refused; the watchdog restores C2 forwarding; the login is refused. */
        objective {
            verify 'SR-006';
            verify 'SR-008';
            verify 'SR-009';
            verify 'SR-014';
            verify 'SR-016';
            verify 'SR-044';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P4";
    }
    verification 'VE-10' : SecurityVerification {
        doc /* CC command filter and logging. Pass: Excluded messages never reach the FC; the approved command does; the flood is limited to the approved rate; each forwarded command is logged with time and WireGuard peer. */
        objective {
            verify 'SR-011';
            verify 'SR-012';
            verify 'SR-013';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P4";
    }
    verification 'VE-11' : SecurityVerification {
        doc /* Supply-chain pipeline and package integrity. Pass: Both bad builds fail; the release has an SBOM, a vulnerability scan and provenance; the tampered artifact and unsigned package are rejected; the offload account cannot read key material. */
        objective {
            verify 'SR-028';
            verify 'SR-031';
            verify 'SR-032';
            verify 'SR-033';
            verify 'SR-038';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P4";
    }
    verification 'VE-12' : SecurityVerification {
        doc /* Tamper-evident seal inspection. Pass: Seals cover every listed access point, and the SD-card access is visibly evident. */
        objective {
            verify 'SR-023';
        }
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P5";
    }
    verification 'VE-13' : SecurityVerification {
        doc /* FC debug port cannot be used. Pass: No debug session can be established, or the port is sealed so that any attempt is evident. */
        objective {
            verify 'SR-024';
        }
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P5";
    }
    verification 'VE-14' : SecurityVerification {
        doc /* FC parameter baseline. Pass: Bits 9 and 11 are set; NAV_TRAFF_AVOID is 0 or 1; uXRCE-DDS is disabled; only the CC-link MAVLink instance is enabled besides USB. */
        objective {
            verify 'SR-020';
            verify 'SR-021';
            verify 'SR-022';
        }
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
    }
    verification 'VE-15' : SecurityVerification {
        doc /* GCS configuration. Pass: Individual logins and screen lock are enforced; the disk is encrypted; only the ground-radio interface is enabled; each sortie record names its operator. */
        objective {
            verify 'SR-026';
            verify 'SR-027';
            verify 'SR-029';
            verify 'SR-030';
        }
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
    }
    verification 'VE-16' : SecurityVerification {
        doc /* MSS configuration and records. Pass: Individual logins; every load and provisioning action is logged with a maintainer; peripheral versions are recorded against the baseline; GCS keys are provisioned wired; key operations happen offline. */
        objective {
            verify 'SR-039';
            verify 'SR-040';
            verify 'SR-041';
            verify 'SR-042';
            verify 'SR-043';
        }
        attribute :>> method = VerificationMethod::'inspection';
        attribute :>> evidenceRepo = "P6";
    }
}
