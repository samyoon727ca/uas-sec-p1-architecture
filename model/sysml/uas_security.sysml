    satisfy 'SR-003' by UAS_Architecture::uasSystem.airVehicle.flightCritical.fc;
    requirement 'SR-004' : SecurityRequirement {
        doc /* The FC shall enter Return mode when no GCS heartbeat has been received for COM_DL_LOSS_T = 10 s (NAV_DLL_ACT = 2). */
        comment rationale /* PX4 disables the GCS-loss failsafe by default. Jamming, tunnel loss and CC failure all appear as data-link loss (DD-01, DD-05). 10 s is the PX4 default timeout, kept as the initial value and checked in VE-01. */
        frame 'THR-009';
        frame 'THR-044';
        attribute :>> method = VerificationMethod::'test';
        attribute :>> evidenceRepo = "P3";
        attribute :>> resiliencyApproach = ("Adaptive Response: Dynamic Reconfiguration");
    }
    satisfy 'SR-004' by UAS_Architecture::uasSystem.airVehicle.flightCritical.fc;
    requirement 'SR-005' : SecurityRequirement {
        doc /* The CC shall boot only boot-chain components signed with the project boot key, verified from a hardware root of trust. */
        comment rationale /* Stops persistent modification of the boot chain from surviving a reboot. */
        frame 'THR-008';
        frame 'THR-010';
        frame 'THR-032';
        attribute :>> method = VerificationMethod::'test';
